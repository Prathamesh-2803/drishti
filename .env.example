# Copernicus Data Space Ecosystem — Sentinel Hub OAuth client credentials.
# Create a client at https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings
# Copy this file to .env and fill in the values. .env is gitignored.

CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

